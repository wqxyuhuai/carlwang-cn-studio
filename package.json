{
  "name": "carlwang-cn-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "format": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "content:publish": "node scripts/publish-oss-content.mjs",
    "content:sync-assets": "node scripts/sync-notion-assets-to-oss.mjs",
    "content:sync-all": "node scripts/sync-notion-assets-to-oss.mjs --rehome-oss --publish-before-status",
    "content:sync-projects": "node scripts/sync-notion-assets-to-oss.mjs --table=projects --rehome-oss --publish-before-status",
    "content:update-all": "npm run content:sync-all && npm run content:publish",
    "content:update-projects": "npm run content:sync-projects",
    "content:sync-categories": "node scripts/sync-notion-assets-to-oss.mjs --table=categories --rehome-oss",
    "content:sync-tools": "node scripts/sync-notion-assets-to-oss.mjs --table=tools --rehome-oss",
    "content:sync-social": "node scripts/sync-notion-assets-to-oss.mjs --table=social --rehome-oss",
    "content:sync-experience": "node scripts/sync-notion-assets-to-oss.mjs --table=experience --rehome-oss",
    "content:update-categories": "npm run content:sync-categories && npm run content:publish",
    "content:update-tools": "npm run content:sync-tools && npm run content:publish",
    "content:update-social": "npm run content:sync-social && npm run content:publish",
    "content:update-experience": "npm run content:sync-experience && npm run content:publish",
    "content:optimize-assets": "node scripts/optimize-oss-assets.mjs",
    "content:optimize-videos": "node scripts/optimize-oss-videos.mjs",
    "content:update-notion-optimized": "node scripts/update-notion-body-media-to-optimized.mjs",
    "content:delete-unused-originals": "node scripts/delete-unused-oss-originals.mjs",
    "content:delete-unused-originals:apply": "node scripts/delete-unused-oss-originals.mjs --delete",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@react-three/fiber": "^9.6.1",
    "ali-oss": "^6.23.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright-core": "^1.54.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.104.0"
  }
}
