{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlwang-cn-studio",
  "account_id": "bb840ab4e8fba0abc7676e55d7df2439",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "WORK_METRICS_DB",
      "database_name": "carlwang-cn-studio-metrics",
      "database_id": "bcfedbb5-fc84-4abe-864c-85a03664787b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_CONTENT_URL": "https://carlwang-cn-studio.oss-cn-shanghai.aliyuncs.com/uploads/admin/site-content.json",
    "ADMIN_CONTENT_SOURCE": "local",
    "ADMIN_COOKIE_SECURE": "true"
  }
}
