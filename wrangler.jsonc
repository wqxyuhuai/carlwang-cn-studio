{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlwang-cn-studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carlwang-cn-studio"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "carlwang-cn-studio-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_CONTENT_URL": "https://carlwang-cn.oss-cn-shanghai.aliyuncs.com/uploads/site-content.json",
    "ADMIN_CONTENT_SOURCE": "local",
    "ADMIN_COOKIE_SECURE": "true"
  }
}
