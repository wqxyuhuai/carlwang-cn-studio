# Public front-end content JSON
NEXT_PUBLIC_CONTENT_URL=https://carlwang-cn.oss-cn-shanghai.aliyuncs.com/uploads/site-content.json

# Admin
# local = use .admin/admin-content.json fallback
# notion = read/write configured Notion databases
