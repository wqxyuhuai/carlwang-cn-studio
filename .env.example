# Public front-end content JSON
NEXT_PUBLIC_CONTENT_URL=https://carlwang-cn-studio.oss-cn-shanghai.aliyuncs.com/uploads/admin/site-content.json

# Admin
# local = use .admin/admin-content.json fallback
# notion = read/write configured Notion databases
ADMIN_CONTENT_SOURCE=local
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Keep default true in production. Set false only for local HTTP production previews.
ADMIN_COOKIE_SECURE=
REVALIDATE_SECRET=

